# External checkouts - kept as separate repos, not part of this one.
/lerobot/
/LIBERO/

# Generated by docker/build.sh (a local copy of the lerobot fork source staged for the
# Docker build context) - regenerable, not source.
/docker/_lerobot_fork_src/

# Run outputs: checkpoints, collected rollout datasets/videos, wandb logs.
**/outputs/
**/wandb/

# Python cruft.
**/__pycache__/
*.pyc
**/*.egg-info/
